# LLM provider configuration for the AI code-review agent.
# Copy to .env and fill in real values locally; never commit .env.

# OpenAI-compatible API key (e.g. OPENAI_API_KEY, OPENROUTER_API_KEY).
# Leave unset for offline/demo mode.
# OPENAI_API_KEY=sk-...

# Model identifier used when LLM mode is enabled (do not hard-code universally).
# OPENAI_MODEL=gpt-4o-mini

# Base URL for OpenAI-compatible endpoints (optional).
# OPENAI_BASE_URL=https://api.openai.com/v1
