# LLM provider configuration for the AI code-review agent.
# Copy to .env and fill in real values locally; never commit .env.

# Which provider --mode llm uses. openai (default) or gemini.
# Unset or openai: a missing OPENAI_API_KEY falls back to demo mode.
# gemini: a missing GEMINI_API_KEY is an error. Demo output is not substituted.
# LLM_PROVIDER=openai

# OpenAI-compatible API key. Leave unset to use offline/demo mode.
# OPENAI_API_KEY=sk-...

# Model identifier used when LLM_PROVIDER=openai (not hard-coded as universal).
# OPENAI_MODEL=gpt-4o-mini

# Base URL for OpenAI-compatible endpoints (optional).
# OPENAI_BASE_URL=https://api.openai.com/v1

# Google Gemini API key. Required when LLM_PROVIDER=gemini.
# Sent only as the x-goog-api-key header. Never commit a real value.
# GEMINI_API_KEY=

# Gemini model id (optional). Default: gemini-2.5-flash
# GEMINI_MODEL=gemini-2.5-flash

# Official Generative Language API root (optional).
# Requests go to {GEMINI_BASE_URL}/models/{model}:generateContent
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
